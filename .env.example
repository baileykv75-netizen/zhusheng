# Server-side gateway only. Never expose DEEPSEEK_API_KEY to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Local gateway defaults. Production Render deployment overrides these in render.yaml.
BUILDING_AGENT_PUBLIC_MODE=false
BUILDING_AGENT_GATEWAY_HOST=127.0.0.1
BUILDING_AGENT_GATEWAY_PORT=4180
BUILDING_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
BUILDING_AGENT_REQUEST_TIMEOUT_MS=12000
BUILDING_AGENT_MAX_INPUT_CHARS=4000
BUILDING_AGENT_MAX_OUTPUT_TOKENS=1200

# Public browser bundle only receives the gateway URL, never the DeepSeek key.
# Example after Render deployment:
# NEXT_PUBLIC_BUILDING_AGENT_GATEWAY_URL=https://zhusheng-building-agent-gateway.onrender.com
NEXT_PUBLIC_BUILDING_AGENT_GATEWAY_URL=
