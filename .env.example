# Server-side gateway only. Never expose DEEPSEEK_API_KEY to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
BUILDING_AGENT_GATEWAY_HOST=127.0.0.1
BUILDING_AGENT_GATEWAY_PORT=4180
BUILDING_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
BUILDING_AGENT_REQUEST_TIMEOUT_MS=12000
BUILDING_AGENT_MAX_INPUT_CHARS=4000
BUILDING_AGENT_MAX_OUTPUT_TOKENS=1200
